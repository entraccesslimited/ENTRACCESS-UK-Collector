# Copy to backend/.env for running the API outside Docker.
ENVIRONMENT=development
DATABASE_URL=sqlite+aiosqlite:///./collector.db
APP_BASE_URL=http://localhost:5180
# Production: APP_BASE_URL=https://entraccess-collector.co.uk (pass links and emails use it)

# Production: both must be long random strings (python -c "import secrets; print(secrets.token_urlsafe(48))").
# Changing PASS_SIGNING_KEY invalidates every pass and code in circulation.
SECRET_KEY=
PASS_SIGNING_KEY=

EMAIL_ENABLED=false
# Zoho Mail sends only as a mailbox that exists, so mail goes from support@,
# and a parent who replies reaches us. Zoho UK SMTP: smtp.zoho.uk, port 587.
EMAIL_FROM=ENTRACCESS UK Collector <support@entraccess-collector.co.uk>
SMTP_HOST=smtp.zoho.uk
SMTP_PORT=587
SMTP_USERNAME=support@entraccess-collector.co.uk
# An app-specific password from Zoho (Security → App passwords), never the login password.
SMTP_PASSWORD=
SMTP_STARTTLS=true
# Website enquiries are also emailed here.
SUPPORT_EMAIL=support@entraccess-collector.co.uk
